{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Cache Operations Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[1m]))",
          "legendFormat": "Hits",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_misses_total[1m]))",
          "legendFormat": "Misses",
          "refId": "B"
        },
        {
          "expr": "sum(rate(cache_evictions_total[1m]))",
          "legendFormat": "Evictions",
          "refId": "C"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "L1 vs L2 Cache Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(cache_l1_latency_seconds_bucket[5m]))",
          "legendFormat": "L1 p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(cache_l2_latency_seconds_bucket[5m]))",
          "legendFormat": "L2 p99",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(cache_db_latency_seconds_bucket[5m]))",
          "legendFormat": "DB p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Bloom Filter Stats",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(bloom_checks_total[1m]))",
          "legendFormat": "Checks",
          "refId": "A"
        },
        {
          "expr": "sum(rate(bloom_rejections_total[1m]))",
          "legendFormat": "Rejections",
          "refId": "B"
        },
        {
          "expr": "sum(rate(bloom_false_positives_total[1m]))",
          "legendFormat": "False Positives",
          "refId": "C"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 5,
      "title": "Total Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 6,
      "title": "Average Response Time",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 7,
      "title": "Error Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["caching", "redis", "performance"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Cache Metrics Dashboard",
  "uid": "cache-metrics",
  "version": 1
}
