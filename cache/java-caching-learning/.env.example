# ============================================
# Java Caching Learning Project
# Environment Configuration Template
# Copy this file to .env and customize
# ============================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caching_db
POSTGRES_USER=cache_user
POSTGRES_PASSWORD=cache_password

# Redis Primary
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis Replicas
REDIS_REPLICA_1_HOST=localhost
REDIS_REPLICA_1_PORT=6380
REDIS_REPLICA_2_HOST=localhost
REDIS_REPLICA_2_PORT=6381

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=cache_user
RABBITMQ_PASSWORD=cache_password

# Application
APP_PORT=8080
SPRING_PROFILES_ACTIVE=default

# Cache Configuration
CACHE_PRODUCTS_TTL=60
CACHE_VERSION=v1

# Bloom Filter
BLOOM_TYPE=memory
BLOOM_EXPECTED_INSERTIONS=100000
BLOOM_FALSE_POSITIVE_RATE=0.01

# Race Condition Settings
MUTEX_WAIT_TIME_MS=5000
MUTEX_LEASE_TIME_MS=30000
PROBABILISTIC_BETA=1.0
PROBABILISTIC_DELTA_MS=5000

# Hot Key Detection
HOTKEY_THRESHOLD=100
HOTKEY_WINDOW_SECONDS=60

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
